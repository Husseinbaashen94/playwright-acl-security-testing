{
  "name": "playwright-acl-security-testing",
  "version": "1.0.0",
  "description": "Access-control and security test suite with Playwright, against a bundled multi-tenant app",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "start": "node app/server.js",
    "start:vulnerable": "VULNERABLE=1 node app/server.js",
    "test:vulnerable": "VULNERABLE=1 playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "verify:detection": "node scripts/verify-detection.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}

# Copy this file to .env and fill in only what you want to change.
# Every value is optional: leave it empty to use the default shown in the comment.
# .env is git-ignored, so values you put there are never committed.

# Port for the bundled TeamNotes app (default: 3210)
PORT=

# Set to 1 to start the app with its 18 planted vulnerabilities (default: empty = secure)
VULNERABLE=
